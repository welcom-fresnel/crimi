// Schéma Prisma pour la gestion centralisée des criminels

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== MODÈLES UTILISATEURS ====================

// Table des utilisateurs (agents de sécurité)
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String   // Mot de passe hashé
  isActive  Boolean  @default(true)
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profile       Profile?
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  criminalsCreated Criminal[] @relation("CreatedBy")
  criminalsUpdated Criminal[] @relation("UpdatedBy")
  evidencesCreated Evidence[] @relation("EvidenceCreatedBy")
  arrestationsCreated Arrestation[] @relation("ArrestationCreatedBy")
  crimesCreated Crime[] @relation("CrimeCreatedBy")
  crimesUpdated Crime[] @relation("CrimeUpdatedBy")
  proceduresCreated Procedure[] @relation("ProcedureCreatedBy")
  decisionsMade Decision[] @relation("DecisionMadeBy")
  validationsSubmitted Validation[] @relation("ValidationSubmittedBy")
  validationsReviewed Validation[] @relation("ValidationReviewedBy")
  requestsCreated Demande[] @relation("DemandeCreatedBy")
  requestsReviewed Demande[] @relation("DemandeReviewedBy")
  versionsCreated DossierVersion[] @relation("VersionCreatedBy")
  resultsPublished ResultatPublie[] @relation("ResultPublishedBy")

  @@map("users")
}

// Table des profils utilisateurs
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String?
  service     String?  // Service d'affectation (Police, Gendarmerie, etc.)
  grade       String?  // Grade de l'agent
  photo       String?  // URL de la photo de profil
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// Table des rôles
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // ADMIN, AGENT, VIEWER
  description String?
  permissions Json     // Permissions sous forme JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

// Table de liaison utilisateurs-rôles (relation many-to-many)
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ==================== MODÈLES CRIMINELS ====================

// Table des types de crimes
model CrimeType {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique // Code du crime (ex: VOL001, MEUR001)
  description String?
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  criminals Criminal[]
  crimes    Crime[]

  @@map("crime_types")
}

// Table des criminels
model Criminal {
  id              String    @id @default(uuid())
  caseNumber      String    @unique // Numéro de dossier unique
  firstName       String
  lastName        String
  alias           String?   // Surnom/Alias
  dateOfBirth     DateTime?
  placeOfBirth    String?
  nationality     String?
  gender          String?   // MALE, FEMALE, OTHER
  photo           String?   // URL de la photo
  fingerprint     String?   // Données d'empreintes digitales
  
  // Informations du crime
  crimeTypeId     String
  crimeDate       DateTime?
  crimeLocation   String?
  description     String    @db.Text
  status          String    @default("ACTIVE") // ACTIVE, ARRESTED, RELEASED, DECEASED, UNKNOWN
  dangerLevel     String?   // LOW, MEDIUM, HIGH, CRITICAL
  
  // Informations de contact
  lastKnownAddress String?
  phoneNumber      String?
  
  // Métadonnées
  createdById     String
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  personSituation String    @default("UNKNOWN")
  offenseState    String    @default("UNDER_INVESTIGATION")

  // Relations
  crimeType   CrimeType @relation(fields: [crimeTypeId], references: [id])
  createdBy   User      @relation("CreatedBy", fields: [createdById], references: [id])
  updatedBy   User?     @relation("UpdatedBy", fields: [updatedById], references: [id])
  evidences   Evidence[]
  arrestation Arrestation?
  crimes      Crime[]
  procedures  Procedure[]
  dossierVersions DossierVersion[]

  @@index([caseNumber])
  @@index([firstName, lastName])
  @@index([crimeTypeId])
  @@index([status])
  @@map("criminals")
}

model Arrestation {
  id              String   @id @default(uuid())
  criminalId      String   @unique
  arrestDate      DateTime?
  arrestLocation  String?
  arrestingUnit   String?
  arrestingOfficer String?
  warrantNumber   String?
  notes           String?  @db.Text
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  criminal  Criminal @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ArrestationCreatedBy", fields: [createdById], references: [id])

  @@index([createdById])
  @@map("arrestations")
}

model Evidence {
  id                  String   @id @default(uuid())
  criminalId          String
  title               String?
  description         String?  @db.Text
  category            String   @default("OTHER")
  collectedAt         DateTime?
  collectedAtLocation String?
  fileUrls            String[]
  fileHashes          String[] @default([])
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  criminal  Criminal @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  createdBy User     @relation("EvidenceCreatedBy", fields: [createdById], references: [id])

  @@index([criminalId])
  @@index([createdById])
  @@index([category])
  @@map("evidences")
}

model Crime {
  id            String   @id @default(uuid())
  criminalId    String
  crimeTypeId   String
  crimeDate     DateTime?
  crimeLocation String?
  description   String   @db.Text
  status        String   @default("ACTIVE") // ACTIVE, ARRESTED, RELEASED, DECEASED, UNKNOWN
  dangerLevel   String?  // LOW, MEDIUM, HIGH, CRITICAL
  createdById   String
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  criminal  Criminal @relation(fields: [criminalId], references: [id], onDelete: Cascade)
  crimeType CrimeType @relation(fields: [crimeTypeId], references: [id])
  createdBy User     @relation("CrimeCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("CrimeUpdatedBy", fields: [updatedById], references: [id])

  @@index([criminalId])
  @@index([crimeTypeId])
  @@index([status])
  @@map("crimes")
}

model Procedure {
  id          String   @id @default(uuid())
  criminalId  String
  reference   String   @unique
  status      String   @default("OPEN")
  summary     String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  criminal    Criminal @relation(fields: [criminalId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("ProcedureCreatedBy", fields: [createdById], references: [id])
  decisions   Decision[]
  validations Validation[]
  requests    Demande[]
  @@index([criminalId])
  @@map("procedures")
}

model Decision {
  id          String   @id @default(uuid())
  procedureId String
  type        String
  reason      String   @db.Text
  decidedAt   DateTime @default(now())
  decidedById String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  decidedBy   User @relation("DecisionMadeBy", fields: [decidedById], references: [id])
  peine       Peine?
  @@index([procedureId])
  @@map("decisions")
}

model Peine {
  id           String   @id @default(uuid())
  decisionId   String   @unique
  nature       String
  durationDays Int?
  notes        String?  @db.Text
  decision     Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  @@map("peines")
}

model Validation {
  id            String   @id @default(uuid())
  procedureId   String
  status        String   @default("DRAFT")
  submittedById String
  reviewerId    String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reason        String?  @db.Text
  procedure     Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  submittedBy   User @relation("ValidationSubmittedBy", fields: [submittedById], references: [id])
  reviewer      User? @relation("ValidationReviewedBy", fields: [reviewerId], references: [id], onDelete: Restrict)
  @@index([procedureId, status])
  @@map("validations")
}

model DossierVersion {
  id          String   @id @default(uuid())
  criminalId  String
  version     Int
  snapshot    Json
  reason      String?
  createdById String
  createdAt   DateTime @default(now())
  criminal    Criminal @relation(fields: [criminalId], references: [id], onDelete: Restrict)
  createdBy   User @relation("VersionCreatedBy", fields: [createdById], references: [id])
  @@unique([criminalId, version])
  @@map("dossier_versions")
}

model Demande {
  id          String   @id @default(uuid())
  procedureId String
  type        String
  payload     Json
  status      String   @default("DRAFT")
  createdById String
  reviewerId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviewedAt  DateTime?
  reason      String?  @db.Text
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  createdBy   User @relation("DemandeCreatedBy", fields: [createdById], references: [id])
  reviewer    User? @relation("DemandeReviewedBy", fields: [reviewerId], references: [id], onDelete: Restrict)
  published   ResultatPublie?
  @@index([procedureId, status])
  @@map("demandes")
}

model ResultatPublie {
  id            String   @id @default(uuid())
  demandeId     String   @unique
  payload       Json
  publishedById String
  publishedAt   DateTime @default(now())
  demande       Demande @relation(fields: [demandeId], references: [id], onDelete: Restrict)
  publishedBy   User @relation("ResultPublishedBy", fields: [publishedById], references: [id])
  @@map("resultats_publies")
}

// ==================== SYSTÈME D'AUDIT ====================

// Table des journaux d'audit
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity      String   // CRIMINAL, USER, CRIME_TYPE, etc.
  entityId    String?
  changes     Json?    // Changements effectués (avant/après)
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  previousHash String?
  hash         String?

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([timestamp])
  @@map("audit_logs")
}

