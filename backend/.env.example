# Configuration Backend - Exemple
# À générer automatiquement avec: .\setup-network.ps1
# Ou à configurer manuellement après changement de réseau

# ============================================
# Base de Données PostgreSQL
# ============================================

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:votre_mot_de_passe@localhost:5432/securit_afrique_db?schema=public"

# ============================================
# Serveur Express
# ============================================

# Port d'écoute du serveur backend
PORT=5000

# Mode : development ou production
NODE_ENV=development

# ============================================
# JWT (Authentification)
# ============================================

# Clé secrète pour signer les tokens JWT
# ⚠️  À CHANGER EN PRODUCTION !
JWT_SECRET=securit_afrique_jwt_secret_key_2024_change_in_production

# Durée d'expiration des tokens
# Format: h (heures), d (jours), etc.
JWT_EXPIRES_IN=24h

# ============================================
# CORS (Accès depuis le Frontend)
# ============================================

# Adresse du frontend (pour autoriser les requêtes CORS)
# Généré automatiquement par setup-network.ps1
CORS_ORIGIN=http://192.168.212.13:8080

# IP du serveur backend (pour logs/debug)
# Généré automatiquement par setup-network.ps1
BACKEND_IP=192.168.212.13

# ============================================
# COMMENT UTILISER CE FICHIER
# ============================================

# 1. AUTOMATIQUEMENT (Recommandé):
#    Exécutez le script: .\setup-network.ps1
#    Il créera automatiquement un .env avec la bonne IP

# 2. MANUELLEMENT:
#    - Renommez ce fichier en ".env"
#    - Remplacez "192.168.212.13" par votre adresse IP réelle
#    - Remplacez le mot de passe PostgreSQL
#    - Changez JWT_SECRET en production

# ============================================
# EXEMPLES DE CONFIGURATION
# ============================================

# Sur le même serveur (développement local):
# CORS_ORIGIN=http://localhost:8080
# DATABASE_URL=postgresql://postgres:password@localhost:5432/securit_afrique_db

# Sur le réseau local:
# CORS_ORIGIN=http://192.168.212.13:8080
# DATABASE_URL=postgresql://postgres:password@192.168.212.13:5432/securit_afrique_db

# Avec PostgreSQL sur serveur distant:
# DATABASE_URL=postgresql://user:password@192.168.1.50:5432/securit_afrique_db
