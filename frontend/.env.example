# URL HTTP de l'API backend.
VITE_API_URL=http://localhost:5000/api
# URL du serveur Socket.io.
VITE_WS_URL=http://localhost:5000
# Adresse de repli du backend si les URLs ci-dessus sont absentes.
VITE_BACKEND_IP=localhost
# Identifiant local du poste affiché/utilisé pour la synchronisation.
VITE_POST_ID=POSTE_LOCAL
# Mode indicatif de l'interface.
VITE_ENV=development
