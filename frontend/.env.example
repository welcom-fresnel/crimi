# Configuration Frontend - Exemple
# À générer automatiquement avec: .\setup-network.ps1
# Ou à configurer manuellement après changement de réseau

# ============================================
# API Backend
# ============================================

# URL base de l'API REST du backend
# Généré automatiquement par setup-network.ps1
VITE_API_URL=http://192.168.212.13:5000/api

# URL WebSocket pour la synchronisation temps réel
# Doit pointer vers le même serveur que VITE_API_URL
VITE_WS_URL=http://192.168.212.13:5000

# IP du backend (pour logs/debug)
# Généré automatiquement par setup-network.ps1
VITE_BACKEND_IP=192.168.212.13

# ============================================
# Configuration du Poste
# ============================================

# ID unique du poste de police
# Utilisé pour la synchronisation multi-postes
VITE_POST_ID=POSTE_PRINCIPAL

# ============================================
# Environment
# ============================================

# Mode : development ou production
VITE_ENV=development

# ============================================
# COMMENT UTILISER CE FICHIER
# ============================================

# 1. AUTOMATIQUEMENT (Recommandé):
#    Exécutez le script: .\setup-network.ps1
#    Il créera automatiquement un .env.local avec la bonne IP

# 2. MANUELLEMENT:
#    - Renommez ce fichier en ".env.local"
#    - Remplacez "192.168.212.13" par votre adresse IP réelle
#    - Adaptez VITE_POST_ID selon votre poste

# ============================================
# EXEMPLES DE CONFIGURATION
# ============================================

# Développement local:
# VITE_API_URL=http://localhost:5000/api
# VITE_WS_URL=http://localhost:5000

# Sur le réseau local:
# VITE_API_URL=http://192.168.212.13:5000/api
# VITE_WS_URL=http://192.168.212.13:5000

# Production avec domaine:
# VITE_API_URL=https://api.securit-afrique-hub.com/api
# VITE_WS_URL=wss://api.securit-afrique-hub.com

# ============================================
# MULTI-POSTES DE POLICE
# ============================================

# Poste A (Dakar):
# VITE_POST_ID=POSTE_A
# VITE_API_URL=http://192.168.212.50:5000/api

# Poste B (Abidjan):
# VITE_POST_ID=POSTE_B
# VITE_API_URL=http://192.168.212.51:5000/api

# Poste C (Lomé):
# VITE_POST_ID=POSTE_C
# VITE_API_URL=http://192.168.212.52:5000/api

# Mais tous pointent vers la MÊME base de données !
# DATABASE_URL=postgresql://...@192.168.212.13:5432/...
